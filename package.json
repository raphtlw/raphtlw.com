{
  "name": "raphtlw.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run sanity:typegen && next build --profile && bun run sanity:manifest",
    "start": "next start",
    "lint": "next lint",
    "format": "next lint --fix .",
    "sanity:typegen": "sanity schema extract --path ./sanity/schema.json && sanity typegen generate --config-path ./sanity/typegen.json",
